{
  "name": "hevi-action",
  "version": "1.4.0",
  "description": "A github action to use hevi",
  "main": "dist/index.js",
  "scripts": {
    "build:types": "tsc --emitDeclarationOnly",
    "build:js": "tsdown",
    "build": "npm run build:types && npm run build:js",
    "lint": "eslint .",
    "lint:fix": "npm run lint -- --fix",
    "test": "npm run build && vitest run --config test/vitest.config.mts",
    "test:coverage": "npm run test -- --coverage"
  },
  "keywords": [],
  "devDependencies": {
    "@tada5hi/commitlint-config": "^1.3.3",
    "@tada5hi/tsconfig": "^0.7.2",
    "@types/node": "^22.13.10",
    "eslint": "^10.14.0",
    "husky": "^8.0.3",
    "typescript": "^5.8.2",
    "@tada5hi/eslint-config": "^3.3.1",
    "typescript-eslint": "^8.72.1",
    "tsdown": "^0.23.7",
    "vitest": "^5.1.0",
    "@vitest/coverage-v8": "^5.1.0"
  },
  "author": {
    "name": "Peter Placzek",
    "email": "contact@tada5hi.net",
    "url": "https://github.com/tada5hi"
  },
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^1.11.1",
    "hevi": "^1.6.1"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.11.0 || >=26.0.0"
    }
  }
}
